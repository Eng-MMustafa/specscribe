{
  "name": "specscribe",
  "version": "1.0.0",
  "description": "Zero-config API documentation for NestJS, Express, Fastify and Hono: OpenAPI docs, live REST/WebSocket/GraphQL consoles, mock server, Postman export and typed SDKs from static analysis — no decorators, no setup",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "specscribe": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "!src/ui/lit/*.ts",
    "!src/ui/lit/*.css",
    "!src/examples/**",
    "!src/controllers/DemoController.ts",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eng-MMustafa/specscribe.git"
  },
  "homepage": "https://github.com/Eng-MMustafa/specscribe#readme",
  "bugs": {
    "url": "https://github.com/Eng-MMustafa/specscribe/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run ui:build && rimraf dist && tsc",
    "ui:build": "node scripts/build-ui.mjs",
    "dev": "tsc --watch",
    "verify:runtime-deps": "node scripts/verify-no-dev-deps-at-runtime.js",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:ci": "jest --coverage --coverageReporters=lcov --coverageReporters=text",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch-generate": "node scripts/watch-generate.js",
    "test:ui": "playwright test"
  },
  "keywords": [
    "nestjs",
    "nestjs-10",
    "nestjs-11",
    "hono",
    "nestjs-12",
    "express",
    "expressjs",
    "fastify",
    "nodejs",
    "api",
    "api-docs",
    "api-documentation",
    "documentation",
    "openapi",
    "openapi3",
    "swagger",
    "swagger-alternative",
    "scalar",
    "redoc",
    "rest",
    "websocket",
    "socket.io",
    "graphql",
    "static-analysis",
    "ast",
    "postman",
    "mock-server",
    "mocking",
    "typed-client",
    "sdk-generator",
    "contract-testing",
    "api-diff",
    "typescript",
    "zero-config",
    "zero-decorator",
    "mohamed-mustafa"
  ],
  "author": {
    "name": "Mohamed Mustafa",
    "url": "https://github.com/Eng-MMustafa"
  },
  "license": "MIT",
  "devDependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "express": "5.2.1",
    "graphql": "^17.0.2",
    "jest": "^29.7.0",
    "lit": "^3.3.2",
    "multer": "2.4.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": ">=0.1.13",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": true
    }
  },
  "overrides": {
    "fastify@>=5": "^5.12.5"
  }
}
